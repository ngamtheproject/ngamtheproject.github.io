{{- /* Local copy of the Kit manifest: icon URLs come from get_site_icon's
       `.resource` (the Kit printed "<no value>"), and the theme and background
       colour stay the site's #3f51b5. */ -}}
{{- $theme_color := "#3f51b5" -}}
{
  "name": "{{site.Title}}",
  "short_name": "{{site.Title}}",
  "lang": "{{ site.Language.Locale | default "en-us" }}",
  "theme_color": "{{ $theme_color }}",
  "background_color": "{{ $theme_color }}",
  "icons": [{
    "src": "{{ (partial "functions/get_site_icon" 192).resource.RelPermalink }}",
    "sizes": "192x192",
    "type": "image/png"
    }, {
    "src": "{{ (partial "functions/get_site_icon" 512).resource.RelPermalink }}",
    "sizes": "512x512",
    "type": "image/png"
     }],
  "display": "standalone",
  "start_url": "{{ site.Home.RelPermalink }}?utm_source=web_app_manifest"
}
