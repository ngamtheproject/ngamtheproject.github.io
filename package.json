{
  "name": "ngamtheproject",
  "version": "1.0.0",
  "private": true,
  "description": "Website for Ngăm, built with Hugo and HugoBlox Kit (Tailwind CSS v4)",
  "scripts": {
    "dev": "hugo server --disableFastRender",
    "build": "hugo --minify && npm run pagefind",
    "pagefind": "pagefind --site public",
    "test": "node --test tests/netlify-footer-host.test.js"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.12",
    "@tailwindcss/typography": "^0.5.10",
    "pagefind": "^1.4.0",
    "preact": "^10.27.2",
    "tailwindcss": "^4.1.12"
  },
  "allowScripts": {
    "@parcel/watcher": false
  }
}
